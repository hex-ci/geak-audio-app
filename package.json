{
  "name": "geak-audio-app",
  "description": "GEAK Audio 果壳智能音响播放工具",
  "version": "2.0.0",
  "author": "Hex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:hex-ci/geak-audio-app.git"
  },
  "main": "background.js",
  "type": "module",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "lint": "eslint . --cache",
    "electron:serve": "node scripts/electron-serve.js",
    "electron:build": "node scripts/electron-build.js",
    "electron:build:all": "node scripts/electron-build.js --mac --win --x64 --arm64",
    "electron:build:ci": "node scripts/electron-build.js --publish never",
    "preview": "vite preview",
    "lint:fix": "eslint . --cache --fix"
  },
  "build": {
    "appId": "com.hex.geak-audio",
    "productName": "GEAK Audio",
    "artifactName": "geak-audio-${os}-${arch}-${version}.${ext}",
    "directories": {
      "output": "dist_electron",
      "app": "dist_electron/bundled"
    },
    "files": [
      "**"
    ],
    "npmRebuild": false
  },
  "dependencies": {},
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^0.23.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "element-plus": "^2.14.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "express": "^5.3.0",
    "get-port": "^5.1.1",
    "globals": "^17.13.0",
    "lodash": "^4.17.21",
    "netmask": "^2.0.2",
    "normalize.css": "^8.0.1",
    "sass": "^1.105.1",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "electron": true
  }
}
