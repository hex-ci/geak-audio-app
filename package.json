{
  "name": "geak-audio-app",
  "description": "GEAK Audio 果壳智能音响播放工具",
  "version": "1.2.0",
  "author": "Hex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:hex-ci/geak-audio-app.git"
  },
  "main": "background.js",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:serve": "node scripts/electron-serve.js",
    "electron:build": "node scripts/electron-build.js",
    "electron:build:all": "node scripts/electron-build.js --mac --win --x64 --arm64",
    "electron:build:ci": "node scripts/electron-build.js --publish never"
  },
  "build": {
    "appId": "com.hex.geak-audio",
    "productName": "GEAK Audio",
    "artifactName": "geak-audio-${os}-${arch}-${version}.${ext}",
    "directories": {
      "output": "dist_electron",
      "app": "dist_electron/bundled"
    },
    "files": [
      "**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "@achingbrain/ssdp": "^2.1.2",
    "axios": "^0.23.0",
    "core-js": "^3.33.1",
    "dayjs": "^1.11.10",
    "element-ui": "2.15.6",
    "express": "^4.18.2",
    "get-port": "^5.1.1",
    "lodash": "^4.17.21",
    "netmask": "^2.0.2",
    "normalize.css": "^8.0.1",
    "upnp-device-client": "^1.0.2",
    "vue": "^2.7.14",
    "vue-router": "^3.6.5",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "babel-loader": "^8.3.0",
    "babel-plugin-component": "^1.1.1",
    "electron": "^13.6.9",
    "electron-builder": "^22.14.13",
    "electron-devtools-installer": "^3.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^7.20.0",
    "sass": "^1.69.4",
    "sass-loader": "^12.6.0",
    "vue-template-compiler": "^2.7.14"
  },
  "allowScripts": {
    "electron": true
  }
}
